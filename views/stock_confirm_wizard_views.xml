<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sync_syscom_stock_confirm_wizard_form" model="ir.ui.view">
            <field name="name">sync.syscom.stock.confirm.wizard.form</field>
            <field name="model">sync.syscom.stock.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Stock insuficiente en SYSCOM">
                    <div class="alert alert-warning" role="alert">
                        SYSCOM reporta que no hay existencia suficiente para uno o más
                        productos de esta orden. Puedes confirmar de todas formas si
                        sabes que se puede surtir por otra vía, o cancelar y revisarlo
                        antes.
                    </div>
                    <field name="order_ids" invisible="1"/>
                    <field name="message" nolabel="1"/>
                    <footer>
                        <button
                            name="action_confirm_anyway"
                            type="object"
                            string="Confirmar de todas formas"
                            class="btn-primary"
                        />
                        <button
                            name="action_cancel"
                            type="object"
                            string="Cancelar"
                            class="btn-secondary"
                        />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
